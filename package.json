{
  "name": "@kjangid/url-encode-tools",
  "version": "1.0.1",
  "description": "Production-grade, zero-runtime-dependency TypeScript URL manipulation, validation, encoding, and decoding toolkit with standalone CLI.",
  "author": "Karan Jangid",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kajangid/URLAndEncodingTools.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/kajangid/URLAndEncodingTools/issues"
  },
  "homepage": "https://github.com/kajangid/URLAndEncodingTools#readme",
  "bin": {
    "url-tools": "dist/bin/cli.cjs",
    "url-encode-tools": "dist/bin/cli.cjs",
    "url-parse": "dist/bin/cli.cjs",
    "query-string": "dist/bin/cli.cjs",
    "url-validate": "dist/bin/cli.cjs",
    "utm-build": "dist/bin/cli.cjs",
    "b64": "dist/bin/cli.cjs",
    "url-encode": "dist/bin/cli.cjs",
    "html-encode": "dist/bin/cli.cjs",
    "hex-convert": "dist/bin/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./url-parser": {
      "types": "./dist/url-parser/index.d.ts",
      "import": "./dist/url-parser/index.mjs",
      "require": "./dist/url-parser/index.cjs"
    },
    "./query-string": {
      "types": "./dist/query-string/index.d.ts",
      "import": "./dist/query-string/index.mjs",
      "require": "./dist/query-string/index.cjs"
    },
    "./url-validator": {
      "types": "./dist/url-validator/index.d.ts",
      "import": "./dist/url-validator/index.mjs",
      "require": "./dist/url-validator/index.cjs"
    },
    "./utm-builder": {
      "types": "./dist/utm-builder/index.d.ts",
      "import": "./dist/utm-builder/index.mjs",
      "require": "./dist/utm-builder/index.cjs"
    },
    "./base64": {
      "types": "./dist/base64/index.d.ts",
      "import": "./dist/base64/index.mjs",
      "require": "./dist/base64/index.cjs"
    },
    "./url-encoder": {
      "types": "./dist/url-encoder/index.d.ts",
      "import": "./dist/url-encoder/index.mjs",
      "require": "./dist/url-encoder/index.cjs"
    },
    "./html-encoder": {
      "types": "./dist/html-encoder/index.d.ts",
      "import": "./dist/html-encoder/index.mjs",
      "require": "./dist/html-encoder/index.cjs"
    },
    "./hex": {
      "types": "./dist/hex/index.d.ts",
      "import": "./dist/hex/index.mjs",
      "require": "./dist/hex/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "utility",
    "url",
    "parser",
    "base64",
    "hex",
    "query-string",
    "utm",
    "encoder",
    "html-encoder",
    "developer-tools",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "publish:dry": "npm publish --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "@vitest/coverage-v8": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
